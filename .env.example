# Docker Compose Settings (выберите файл по умолчанию при необходимости)
# COMPOSE_FILE=docker-compose.local.yml
# COMPOSE_FILE=docker-compose.prod.yml

# Backend Environment Variables
MU_API_KEY=your_api_key_here

# Google OAuth
GOOGLE_TIP="WEB" #DESKTOP | WEB
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CLIENT_DESKTOP_ID="your_google_desktop_client_id"
GOOGLE_CLIENT_DESKTOP_SECRET="your_google_desktop_client_secret"

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vibeflow

# Database URLs (для контейнерной сети — хост "db")
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/vibeflow"
DIRECT_URL="postgresql://postgres:postgres@db:5432/vibeflow"

# JWT
JWT_SECRET_KEY="change_this_to_a_random_secret_key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# SMTP (для верификации email и сброса пароля)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="VibeFlow"
SMTP_FROM_EMAIL=""

# App
APP_URL="http://localhost:5000"

# Super Admin
SUPER_ADMIN_EMAIL="admin@example.com"

# Token System (conversion rate: tokens per $1)
TOKEN_RATE_PER_DOLLAR=100
